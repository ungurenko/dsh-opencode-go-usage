{
  "name": "@local/dsh-opencode-go-usage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "OpenCode Go subscription usage limits in the Harness left sidebar",
  "license": "MIT",
  "author": "ungurenko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ungurenko/dsh-opencode-go-usage.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "opencode",
    "opencode-go",
    "usage",
    "limits"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
